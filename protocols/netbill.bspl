NetBill {
  roles Customer, Merchant
  parameters out ID key, out item, out price, out done
  private confirmation, document, payment
  
  // Customer initiates: requests a quote for an item
  Customer -> Merchant: rfq[out ID, out item]
  
  // Merchant responds: provides price for the item
  Merchant ->  Customer: offer[in ID, in item, out price]
  
  // Customer accepts: confirms purchase
  Customer -> Merchant: accept[in ID, in item, in price, out confirmation]
  
  // Merchant sends goods: delivers goods/digital items with receipt document
  Merchant -> Customer: goods[in ID, in item, in confirmation, out document]
  
  // Customer pays: provides payment based on goods document (NetBill-style pay-after-receipt)
  Customer -> Merchant: pay[in ID, in price, in document, out payment]
  
  // Merchant sends receipt: transaction complete
  Merchant -> Customer: receipt[in ID, in item, in payment, out done]
}
